# Example ONLY — copy locally to .env and replace every placeholder.
# No committed secrets, private keys, credentials or certificate material.
# Pin an inspected local build that supports --tls-reload-hostname; see README.
FOUNDRY_ROUTER_IMAGE=REPLACE_WITH_VERIFIED_IMAGE
# Must appear in the certificate SAN; the M0 health probe requires public CA trust.
# This address must be resolvable and reachable by every external client.
FOUNDRY_ROUTER_HOST=REPLACE_WITH_CERTIFICATE_DNS_HOST
FOUNDRY_ROUTER_PORT=8787
# Absolute host directory; must contain server.crt and server.key.
FOUNDRY_TLS_DIR=REPLACE_WITH_ABSOLUTE_CERTIFICATE_DIRECTORY
