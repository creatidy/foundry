# Optional local settings. Defaults need no .env, certificates or image hash.
# No committed secrets, private keys, credentials or certificate material.
# Leave unset to build the exact inspected Dockerfile.mi automatically.
# FOUNDRY_ROUTER_IMAGE=your-independently-inspected-image
# Keep 8787 for normal browser Host validation; remapping alone does not change SR.
FOUNDRY_ROUTER_PORT=8787
FOUNDRY_WORKER_PORT=8790
# Advanced `make tls-up` only: publicly trusted hostname-matching chain/key.
# FOUNDRY_ROUTER_HOST=router.example.com
# FOUNDRY_TLS_DIR=/absolute/protected/tls
